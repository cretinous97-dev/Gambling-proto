# Copy to backend/.env and edit. NEVER commit the real file.
#
# The defaults below are safe for a laptop and DANGEROUS in production:
# the sandbox provider moves no real money, and the seeded admin password is
# public knowledge. Anything you change here is what actually runs.
#
# Nothing in this file is required to get the app running. Every provider key
# is empty by default and the app boots with the sandbox simulator instead, so
# you can see the whole product work before you have a merchant account.
# Add live keys when you have them - the code paths are already there.

# --- core -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=Naktsang Casino

# --- security -------------------------------------------------------------
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The app REFUSES TO BOOT in production while this is still the default.
# Changing it signs every player out (tokens are signed with it), so set it
# once and keep it stable.
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MIN=1440
REFRESH_TOKEN_TTL_DAYS=30

# --- public URL -----------------------------------------------------------
# Where players reach this site. Used to build the return URLs a PSP sends the
# shopper back to after a 3DS challenge or a hosted-checkout page, so it must
# be the real public origin in production - a wrong value strands the player
# on a page that cannot finish the payment. It is read from the environment
# rather than the settings object because the payment adapters need it at
# request time (see app/payments/adyen.py).
APP_BASE_URL=http://localhost:5173

# --- database -------------------------------------------------------------
# SQLite is fine for development and for a single-instance deployment.
# Postgres is required for a real one: serverless filesystems are wiped
# between cold starts, so balances only persist on a hosted database.
#
#   DATABASE_URL=postgresql+psycopg://casino:password@host:5432/casino
#   DATABASE_URL=sqlite:///./data/casino.db
#
# The schema (users, wallets, ledger accounts, transactions, entries) is
# plain SQL in backend/sql/schema.sql; load it with `make schema` or run the
# app and let it create the tables on first boot.
DATABASE_URL=

# --- payments -------------------------------------------------------------
# sandbox       = built-in simulator. No real money. The default, and the only
#                 provider with no keys to configure.
# adyen         = cards, local methods and payouts through YOUR Adyen account.
# stripe        = cards and payouts through YOUR Stripe account.
# cryptopay     = on-chain deposits/payouts through YOUR provider account.
# bank_transfer = locally negotiated bank/wallet rails. Does not talk to one
#                 fixed API: each rail is a row in `banking_methods`, added in
#                 the admin panel, with its own endpoint, account id and
#                 currency. This is the one to use for domestic rails.
#
# This value is the DEFAULT. A banking pathway may name its own provider, and
# a pathway that names none uses this one - so promoting a deployment from
# sandbox to live does not require editing every row.
#
# Everything else about the payment flow - intents, holds, webhooks,
# idempotency, the ledger - is provider-independent.
PAYMENT_PROVIDER=sandbox

# The merchant / account id money is collected into. Not a secret: it is
# printed on the player's own statement, and it is the default `account_id`
# on the pathways seeded on first boot. Each pathway can override it, because
# a global acquirer and a local bank do not share one.
MERCHANT_ACCOUNT_ID=

# HMAC key for callbacks from bank/wallet rails (the pathways you add in the
# admin panel under "Banking methods"). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it empty and those callbacks are REFUSED, not trusted - a missing
# secret must never mean "accept anything".
BANK_TRANSFER_WEBHOOK_SECRET=

# Adyen (recommended if you need card + local payment methods + payouts):
#   API key and merchant account come from your Adyen Customer Area.
#   ADYEN_HMAC_KEY is the webhook HMAC key; without it incoming webhooks are
#   rejected, which is the correct behaviour and not a bug.
#   ADYEN_BALANCE_ACCOUNT_ID is only needed for payouts (withdrawals).
#   Keep ADYEN_ENVIRONMENT=test until your account is live-enabled.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
ADYEN_ENVIRONMENT=test
ADYEN_BALANCE_ACCOUNT_ID=

# Stripe:
#   STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you create in the
#   Stripe dashboard. Signature verification is mandatory - a missing secret
#   means webhooks are rejected, not trusted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CryptoPay (or any provider with the same shape - see app/payments/base.py):
CRYPTOPAY_API_KEY=
CRYPTOPAY_WEBHOOK_SECRET=

# --- jurisdiction policy --------------------------------------------------
# How the platform decides which countries may register, play and move money.
# This is a POLICY switch, not a safety mechanism:
#
#   allow_all  -> every country is accepted. The default.
#   blocklist  -> every country except JURISDICTION_BLOCKLIST
#   allowlist  -> only the countries in JURISDICTION_ALLOWLIST
#
# The default here is deliberately open. Which markets you accept players
# from is your licensing decision, not something a config file should decide
# for you - so nothing is blocked until you say so. Set the list that matches
# the licences you actually hold.
JURISDICTION_MODE=allow_all
JURISDICTION_BLOCKLIST=
JURISDICTION_ALLOWLIST=
# Middle tier: accounts and gameplay allowed, deposits and withdrawals
# refused. Useful for markets where you can offer play but not payments.
RESTRICTED_REGIONS=
# Trust the CDN's country header (x-vercel-ip-country and friends) as the
# caller's region. Off by default: with allow_all it changes nothing, and if
# you turn on geo-blocking you should verify your edge sets the header before
# relying on it.
GEO_ENFORCEMENT=false

# --- localization ---------------------------------------------------------
# Region defaults, used when a player's country has no pathway configured yet
# and as the fallback currency for an unrecognised market.
DEFAULT_COUNTRY=BT
DEFAULT_CURRENCY=BTN

# Localization is a DISPLAY concern. The ledger keeps ONE settlement currency
# (USD, integer cents); every balance, bet, limit and payout is stored and
# enforced in it. These settings decide language and presentation only - they
# can never change what a bet is worth. See app/i18n.py.
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,es,pt,de,fr,it,zh,hi,ar
SETTLEMENT_CURRENCY=USD
# Leave empty to offer every currency the FX table knows about.
DISPLAY_CURRENCIES=
# Presentation rates relative to the settlement currency, as JSON. These are
# NOT used to price a bet or settle a ledger entry. Update them from your
# treasury feed (admin: GET/PUT /api/admin/fx-rates) before showing real
# customers a converted figure - a stale rate is a customer-facing promise.
FX_RATES={"EUR": 0.92, "GBP": 0.79, "BTN": 83.4, "INR": 83.4}

# --- limits and compliance ------------------------------------------------
MIN_DEPOSIT_USD=5
MAX_DEPOSIT_USD=10000
MIN_WITHDRAWAL_USD=10
MAX_WITHDRAWAL_USD=5000
WITHDRAWAL_FEE_PCT=0
# 0 means EVERY withdrawal is reviewed by a human. Keep it that way until you
# have a fraud process you trust.
AUTO_APPROVE_WITHDRAWAL_UNDER_USD=0
KYC_REQUIRED_ABOVE_USD=1000
SELF_EXCLUSION_GATE=true

# --- bonuses --------------------------------------------------------------
SIGNUP_BONUS_USD=0
FIRST_DEPOSIT_BONUS_PCT=100
FIRST_DEPOSIT_BONUS_MAX_USD=100
FIRST_DEPOSIT_BONUS_WAGER_X=30
RAKEBACK_PCT=0.5

# --- ops ------------------------------------------------------------------
MIN_BET_USD=0.10
MAX_BET_USD=2000
# Hard ceiling on a single bet's payout. House edge protects you over many
# bets; this protects you from the one-in-a-million maximum-stake hit.
MAX_WIN_USD=100000
RATE_LIMIT_BETS_PER_MIN=240
# The operator account, created on first boot and bcrypt-hashed (cost 12)
# before it reaches the database. The plaintext is never stored, logged or
# returned by any endpoint. Change the password from the back office:
#   PATCH /api/auth/password
#
# Changing ADMIN_EMAIL later does NOT rename an existing account; it
# provisions the new address alongside it, with a warning in the log.
ADMIN_EMAIL=admin@casino.example.com
ADMIN_PASSWORD=change-this-before-you-deploy

# --- frontend (vite) ------------------------------------------------------
# Origins allowed to call the API from a browser. Use your real domain in prod.
# CORS_ORIGINS=https://your-casino-domain.com
